# Razorpay test credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-test-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# AgentShield mandate signing secret.
# Use at least 32 random bytes in a real environment.
MANDATE_SECRET_KEY=replace-with-at-least-32-random-bytes

# Persistence/runtime
DATABASE_PATH=state.db
MANDATE_TTL_SECONDS=300
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=10

# API authentication
# Use at least 32 random characters.
AGENTSHIELD_API_TOKEN=replace-with-at-least-32-random-characters
AGENTSHIELD_API_USER_ID=user_123
AGENTSHIELD_API_AGENT_ID=agent_001

# Active LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# Local buildathon/demo mode
# Keep false for normal fail-closed operation.
AGENTSHIELD_DEMO_MODE=false